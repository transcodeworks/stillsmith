{
  "name": "@stillsmith/capture",
  "version": "0.2.0",
  "description": "Capture product screenshots from your real components. Declare scenes alongside your code; stillsmith drives a browser and writes the images.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transcodeworks/stillsmith.git",
    "directory": "packages/capture"
  },
  "homepage": "https://transcodeworks.github.io/stillsmith",
  "bugs": {
    "url": "https://github.com/transcodeworks/stillsmith/issues"
  },
  "type": "module",
  "bin": {
    "stillsmith": "./bin/stillsmith.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./annotate": {
      "types": "./dist/annotate/index.d.ts",
      "import": "./dist/annotate/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "screenshots",
    "playwright",
    "vite",
    "react",
    "docs",
    "storybook"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stillsmith/annotate": "workspace:^",
    "esbuild": "^0.28.1",
    "react-resizable-panels": "^4.12.2",
    "tinyglobby": "^0.2.10",
    "ts-morph": "^28.0.0",
    "vite": "^8.1.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "playwright": ">=1.44",
    "react": ">=18",
    "react-dom": ">=18",
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@stillsmith/tour": "workspace:*",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.48.0",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.3",
    "tsup": "^8.3.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
